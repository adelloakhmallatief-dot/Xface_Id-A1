    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- Topi, sedikit miring seperti di sketsa -->
    <group
        android:pivotX="32"
        android:pivotY="22"
        android:rotation="-6">
        <path
            android:fillColor="#00000000"
            android:pathData="M22,22 L24,10 L40,10 L42,22"
