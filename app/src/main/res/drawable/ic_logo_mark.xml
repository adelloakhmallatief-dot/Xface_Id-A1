            android:strokeColor="#86DDEB"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3" />
    </group>

    <!-- Empat bracket pojok -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,38 L12,34 Q12,30 16,30 L20,30 M44,30 L48,30 Q52,30 52,34 L52,38 M12,54 L12,58 Q12,62 16,62 L20,62 M44,62 L48,62 Q52,62 52,58 L52,54"
