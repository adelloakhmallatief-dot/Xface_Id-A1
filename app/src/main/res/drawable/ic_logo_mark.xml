        android:strokeWidth="3" />

    <!-- Mata -->
    <path
        android:fillColor="#00000000"
        android:pathData="M24,42 L24,47 M40,42 L40,47"
        android:strokeColor="#86DDEB"
        android:strokeLineCap="round"
        android:strokeWidth="3" />

    <!-- Senyum -->
